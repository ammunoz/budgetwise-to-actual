# Required: Actual Budget server (self-hosted default: http://localhost:5006).
# Hosted options: see https://actualbudget.org/docs/install/
ACTUAL_SERVER_URL=http://localhost:5006
ACTUAL_PASSWORD=

# Required: Budgetwise Express backend (read-only).
# Verified against my.budgetwise.io (user-facing web app, circa 2026-08).
BUDGETWISE_EMAIL=
BUDGETWISE_PASSWORD=

# Optional: which Budgetwise budget to operate on when --budget is not given.
# Find with: curl https://ex.budgetwise.io/api/budgets -H "Authorization: Bearer: <jwt>"
BUDGETWISE_BUDGET_ID=

# Optional: override the Budgetwise API host (defaults to the production host).
# Set this only if you're testing against a non-production deployment.
# BUDGETWISE_API_URL=https://ex.budgetwise.io

# Optional: paths
ACTUAL_DATA_DIR=./.actual-data
CAPTURED_DIR=../captured
